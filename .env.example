# Configuracao do servidor
PORT=3000
NODE_ENV=development

# Para demonstracao sem conta de e-mail real, use Ethereal.
# O sistema gera uma caixa SMTP temporaria e mostra o link de preview no log.
SMTP_MODE=ethereal

# Para um provedor real, remova SMTP_MODE=ethereal e preencha:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu_email@gmail.com
# SMTP_PASS=sua_senha_de_app
# SMTP_FROM=Gestra <seu_email@gmail.com>
